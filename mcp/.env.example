# Turso database of the web app. Use a read-only token: turso db tokens create fuelmeter --read-only
TURSO_DATABASE_URL=file:../local.db
TURSO_AUTH_TOKEN=
# Long random secret, e.g. openssl rand -hex 32. The MCP endpoint is public; every other /api route (Studio included) returns 401 without it.
MCP_KEY=
# Timezone of the house (the dashboard computes on browser time). Default Europe/Rome.
HOME_TZ=
